# ── Backend configuration ────────────────────────────────────────────────
# Copy this file to `.env` and adjust values for your local environment.

# Port the NestJS server listens on.
PORT=3001

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jefarelid?schema=public"

# Origin allowed to make credentialed (cookie) requests via CORS.
CORS_ORIGIN="http://localhost:3000"

# Secret used to sign the session cookie. Use a long random value in production.
SESSION_SECRET="dev-insecure-secret-change-me"

# Production only: when the frontend and backend are on different HTTPS domains
# (e.g. two Railway services), set this to "true" so the session cookie is
# Secure + SameSite=None and the browser keeps it. Leave unset/false locally.
COOKIE_SECURE="false"

# Production only: absolute path to a mounted volume for uploaded files, so they
# survive redeploys. Leave unset locally (defaults to <backend>/uploads).
# UPLOAD_DIR="/data/uploads"

# SMTP (local mail catcher for development — Mailhog/Ethereal). Used in step 12.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="JEFARELID System <no-reply@jefarelid.test>"
